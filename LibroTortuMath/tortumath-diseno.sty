%% ---------- Como se hace: pasos con flechas ----------
\usetikzlibrary{chains}
\newcommand{\tmcomo}[2]{%
\begin{tcolorbox}[enhanced,colback=white,colframe=tmMorado,boxrule=0.8pt,arc=6pt,before skip=10pt,after skip=10pt,
  title={\ding{228}\; C\'omo se hace: #1},fonttitle=\sffamily\bfseries\small,colbacktitle=tmMorado,coltitle=white,left=1mm,right=1mm]
\centering
\begin{tikzpicture}[start chain=going right,node distance=5mm,every node/.style={font=\sffamily\scriptsize},
  every join/.style={-{Stealth},tmOro,line width=1.5pt}]
 \foreach \t [count=\i] in {#2}{%
  \node[on chain,join,draw=tmMorado,fill=tmMorado!8,rounded corners=5pt,text width=2.5cm,align=center,inner sep=4pt,minimum height=1.5cm]
   {\textcolor{tmMorado}{\textbf{\i}}\\\t};}
\end{tikzpicture}
\end{tcolorbox}}

%% ---------- Formula con burbujas y flechas ----------
\newcommand{\tmformulanota}[3]{%
\par\vspace{6pt}\begin{center}\begin{tikzpicture}[every node/.style={font=\sffamily\scriptsize}]
 \node[draw=tmAmbar,fill=tmAmbarClaro,rounded corners=5pt,inner sep=7pt,line width=1pt,font=\normalsize] (f) {$\displaystyle #1$};
 \node[draw=tmAzul,fill=tmAzulClaro,rounded corners=9pt,align=center,text width=3.7cm,inner sep=4pt] (a) at ([xshift=-3.6cm,yshift=-1.7cm]f.south) {#2};
 \node[draw=tmVerde,fill=tmVerdeClaro,rounded corners=9pt,align=center,text width=3.7cm,inner sep=4pt] (b) at ([xshift=3.6cm,yshift=-1.7cm]f.south) {#3};
 \draw[-{Stealth},tmAzul,line width=1.3pt] (a.north) to[bend left=18] ([xshift=-0.9cm]f.south);
 \draw[-{Stealth},tmVerde,line width=1.3pt] (b.north) to[bend right=18] ([xshift=0.9cm]f.south);
\end{tikzpicture}\end{center}\par\vspace{4pt}}

