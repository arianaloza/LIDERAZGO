%% ---------- Mapa mental: \tmmapa{Centro}{{rama1},{rama2},...,{rama6}} ----------
\newcommand{\tmmapa}[2]{%
\begin{center}\begin{tikzpicture}[every node/.style={align=center,font=\sffamily\small}]
  \node[circle,fill=tmNavy,text=tmCrema,font=\sffamily\bfseries,inner sep=6pt,text width=2.4cm] (c) {#1};
  \foreach \t [count=\i from 0] in {#2}{%
    \pgfmathsetmacro{\ang}{90-60*\i}
    \node[rounded corners=6pt,fill=tmAzulClaro,draw=tmAzul,line width=0.8pt,text width=3.1cm,inner sep=5pt]
      (r\i) at (\ang:4.3cm and 3.1cm) {\t};
    \draw[tmOro,line width=1.2pt] (c) -- (r\i);}
\end{tikzpicture}\end{center}}

