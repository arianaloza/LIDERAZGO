%% ---------- Diagramas de Venn: \tmvenn{union|inter|dif|comp|sim} ----------
\def\tmv@union{\fill[tmAzul!35] (0,0) circle (1); \fill[tmAzul!35] (1.3,0) circle (1);}
\def\tmv@inter{\begin{scope}\clip (0,0) circle (1); \fill[tmAzul!35] (1.3,0) circle (1);\end{scope}}
\def\tmv@dif{\fill[tmAzul!35] (0,0) circle (1); \begin{scope}\clip (1.3,0) circle (1); \fill[white] (-2,-2) rectangle (4,2);\end{scope}}
\def\tmv@comp{\fill[tmAzul!35] (-1.5,-1.4) rectangle (2.8,1.4); \fill[white] (0,0) circle (1);}
\def\tmv@sim{\tmv@union \begin{scope}\clip (0,0) circle (1); \fill[white] (1.3,0) circle (1);\end{scope}}
\newcommand{\tmvenn}[1]{\begin{tikzpicture}[scale=0.5,baseline=(current bounding box.center)]
  \csname tmv@#1\endcsname
  \draw[tmNavy,line width=0.5pt] (-1.5,-1.4) rectangle (2.8,1.4);
  \draw[tmNavy,line width=0.7pt] (0,0) circle (1) (1.3,0) circle (1);
  \node[font=\sffamily\scriptsize] at (-0.55,0) {$A$}; \node[font=\sffamily\scriptsize] at (1.85,0) {$B$};
\end{tikzpicture}}

