%% Apertura de capitulo: macro \tmcapitulo{color}{gancho}{lista de temas}
\newcommand{\tmcapcolor}{tmAzul}
\newcommand{\tmcapgancho}{}
\newcommand{\tmcapitulo}[3]{%
 \renewcommand{\tmcapcolor}{#1}\renewcommand{\tmcapgancho}{#2}\def\tmcaptemas{#3}}
\newcommand{\tmchaphead}[1]{%
\begin{tikzpicture}[remember picture,overlay]
  \fill[tmNavy] (current page.north west) rectangle ([yshift=-8.2cm]current page.north east);
  \begin{scope}[shift={([xshift=-1cm,yshift=-4.6cm]current page.north east)},rotate=20]
    \tmespiral{tmOro,line width=0.9pt,opacity=0.55}{900}
  \end{scope}
  \fill[\tmcapcolor] ([yshift=-8.2cm]current page.north west) rectangle ([yshift=-8.45cm]current page.north east);
  \node[anchor=north west,text=\tmcapcolor!60!white,font=\sffamily\bfseries\fontsize{96}{96}\selectfont,opacity=0.9]
       at ([xshift=2.2cm,yshift=-1.2cm]current page.north west) {\thechapter};
  \node[anchor=north west,text=tmCrema,font=\sffamily\bfseries\fontsize{30}{34}\selectfont,text width=0.62\paperwidth]
       at ([xshift=2.5cm,yshift=-4.2cm]current page.north west) {#1};
  \node[anchor=north west,text=tmOro,font=\sffamily\small,text width=0.6\paperwidth]
       at ([xshift=2.5cm,yshift=-6.9cm]current page.north west) {\tmcapgancho};
  \node[anchor=south east] at ([xshift=-1.6cm,yshift=-3.1cm]current page.north east) {\tortu[1.1]{\tmcapcolor}};
  \node[anchor=south west] at ([xshift=4cm,yshift=-8.2cm]current page.north west) {\tortu[0.3]{tmCrema}};
  \node[anchor=south west] at ([xshift=7cm,yshift=-8.2cm]current page.north west) {\tortu[0.4]{tmOro}};
  \node[anchor=south west] at ([xshift=11cm,yshift=-8.2cm]current page.north west) {\tortu[0.5]{tmCrema}};
  \node[anchor=south west] at ([xshift=15cm,yshift=-8.2cm]current page.north west) {\tortu[0.35]{tmOro}};
\end{tikzpicture}\par}
\titleformat{\chapter}[block]{\normalfont}{}{0pt}{\tmchaphead}
\titlespacing*{\chapter}{0pt}{-1.5cm}{6.6cm}
\titleformat{name=\chapter,numberless}[block]{\normalfont\sffamily\bfseries\Huge\color{tmNavy}}{}{0pt}{}[{\color{tmOro}\titlerule[2pt]}]
\titlespacing*{name=\chapter,numberless}{0pt}{0pt}{20pt}

