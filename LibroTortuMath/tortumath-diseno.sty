%% ---------- Mascota Tortu ----------
\newcommand{\tortu}[2][1]{%
\begin{tikzpicture}[scale=#1,baseline=(tc.south)]
  \coordinate (tc) at (0,-0.25);
  \fill[#2!80!black] (-0.95,-0.1) -- (-1.25,-0.05) -- (-0.95,0.12) -- cycle;
  \foreach \x in {-0.6,0.5}{\fill[#2] (\x,-0.1) ellipse (0.2 and 0.22);}
  \fill[#2] (1.0,0.12) circle (0.27);
  \fill[#2] (0.8,0.0) rectangle (1.05,0.3);
  \fill[white] (1.1,0.2) circle (0.075); \fill[black] (1.13,0.2) circle (0.035);
  \draw[black,line width=0.5pt] (1.12,0.03) arc (-30:-120:0.1);
  \fill[#2!65!black] (-0.9,0) arc[start angle=180,end angle=0,x radius=0.9,y radius=0.75] -- cycle;
  \draw[white,opacity=0.6,line width=0.6pt] (0,0) -- (0,0.72) (-0.45,0) -- (-0.3,0.55) (0.45,0) -- (0.3,0.55);
  \draw[white,opacity=0.6,line width=0.6pt] (-0.62,0.38) -- (0.62,0.38);
\end{tikzpicture}}

%% ---------- Espiral aurea (decoracion) ----------
\newcommand{\tmespiral}[2]{% #1 = estilo del trazo, #2 = vueltas (grados)
\draw[#1,domain=0:#2,samples=400,smooth,variable=\t]
 plot ({6*exp(-0.3063*\t/90)*cos(\t)},{6*exp(-0.3063*\t/90)*sin(\t)});}

